PORT=8056
HOST=0.0.0.0
CORS_ORIGIN=*
API_TOKEN=

# Gemini API (Direct HTTPS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ClickHouse Cloud (Direct HTTPS — used for controlled outcome writes)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Official ClickHouse MCP Server (mcp-clickhouse) — ClickHouse Partner Track requirement
# Installed via: pip install -r requirements.txt (mcp-clickhouse==0.6.0)
CLICKHOUSE_MCP_COMMAND=mcp-clickhouse
CLICKHOUSE_MCP_ARGS=
CLICKHOUSE_ALLOW_WRITE_ACCESS=false

# Optional: Remote MCP endpoint (e.g. https://mcp.clickhouse.cloud/mcp)
# Leave empty to use local stdio mcp-clickhouse (recommended for deployment).
MCP_CLICKHOUSE_URL=
MCP_CLICKHOUSE_TOKEN=

# Set to true to fail fast if live ClickHouse is unavailable (CI/prod validation).
CINEPILOT_REQUIRE_LIVE_MCP=false
